# Local Drupal CAP Feed Source endpoint.
DRUPAL_FEED_SOURCES_URL=https://my-local.site/path/to/feeds/as/json

# Shared secret configured in Drupal at:
# /admin/config/services/cap-alerts/aggregator-connector
DRUPAL_AGGREGATOR_SECRET=<replace-with-key-entity-value>

# Local normalized output file written by `npm run local:poll`.
LOCAL_OUTPUT_FILE=.local-output/aggregator.json

# Directory containing one GeoJSON boundary per park. Files use the supplied
# `<shortcode>-boundary_10m.geojson` convention, with optional resolution suffix.
BOUNDARIES_DIR=assets/boundary_data
LOCAL_OUTPUT_DIR=.local-output/parks