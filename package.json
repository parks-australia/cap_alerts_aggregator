{
  "name": "cap-alerts-aggregator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "local:poll": "node src/local.js",
    "format": "prettier --write .",
    "sam:build": "sam build",
    "sam:validate": "sam validate --lint",
    "showData": "npm run local:poll && jq '.sources[] | {id, status, error,fetched: (.ingestion.fetches // [] | length),canonicalLinks: .ingestion.canonicalLinkCount,documents: .ingestion.documentCount,ingestedAlerts: ((.ingestedAlerts // []) | length),currentAlerts: (.alerts | length)}' .local-output/aggregator.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.879.0",
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/client-ssm": "^3.879.0",
    "@turf/boolean-intersects": "^7.2.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/circle": "^7.2.0",
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  }
}
